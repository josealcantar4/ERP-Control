rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para el sistema ERP Control de Transferencias
    match /usuarios/{document} {
      allow read, write: if true;
    }

    match /medicamentos/{document} {
      allow read, write: if true;
    }

    match /solicitudes/{document} {
      allow read, write: if true;
    }

    match /sedes/{document} {
      allow read, write: if true;
    }

    match /areas/{document} {
      allow read, write: if true;
    }

    match /catalogo_limpio/{document} {
      allow read, write: if true;
    }

    match /material_brindado/{document} {
      allow read, write: if true;
    }

    match /material_tipos/{document} {
      allow read, write: if true;
    }

    match /material_personal/{document} {
      allow read, write: if true;
    }

    // Por defecto bloquear cualquier otra colección no definida
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
